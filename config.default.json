{
  "language": "auto",
  "monochrome": true,
  "quietWhileGaming": true,
  "alwaysShowInTray": true,
  "update": {
    "repo": "swarlex/SwarlexBattery",
    "check": true,
    "intervalHours": 6,
    "beta": false
  },
  "panel": {
    "width": 320,
    "maxHeight": 620
  },
  "theme": {
    "panel": "#EB202020",
    "foreground": "#f2f2f2",
    "muted": "#9a9a9a",
    "accent": "#f2f2f2",
    "ok": "#f2f2f2",
    "warn": "#f5a524",
    "error": "#f04a4a"
  },
  "plugins": {
    "gadgets": {
      "systemBattery": true,
      "bluetooth": true,
      "xinput": true,
      "showDisconnected": false,
      "showPercentage": true,
      "lowThreshold": 15,
      "names": {},
      "externalPath": "",
      "hid": true,
      "combine": true,
      "interval": 30,
      "timeLeft": true
    }
  },
  "statusFile": false,
  "iconPercent": false
}
