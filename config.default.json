{
  "monochrome": true,
  "simpleMenu": true,
  "quietWhileGaming": true,
  "alwaysShowInTray": true,
  "update": {
    "repo": "yukicanclaude/SwarlexBattery",
    "check": true,
    "intervalHours": 6
  },
  "panel": {
    "width": 320,
    "maxHeight": 620,
    "backdrop": "acrylic",
    "opacity": 0.6
  },
  "theme": {
    "background": "#1c1c1c",
    "panel": "#EB202020",
    "foreground": "#f2f2f2",
    "muted": "#9a9a9a",
    "accent": "#f2f2f2",
    "ok": "#f2f2f2",
    "warn": "#f5a524",
    "error": "#f04a4a"
  },
  "order": ["gadgets", "pocket", "sync", "mouse", "glass"],
  "plugins": {
    "gadgets": {},
    "pocket": { "enabled": false },
    "sync": { "enabled": false },
    "mouse": { "enabled": false },
    "glass": { "enabled": false }
  }
}
